
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday, My Love ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --pink: #ff8fab;
    --light-pink: #ffe4ec;
    --rose: #e75480;
    --purple: #b8a1e3;
    --cream: #fff8f5;
    --dark: #593747;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--cream);
    color: var(--dark);
    overflow-x: hidden;
}

button, input, textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
    border: none;
}

section {
    padding: 80px 20px;
    text-align: center;
}

h1, h2 {
    font-family: 'Great Vibes', cursive;
    font-weight: normal;
}

h2 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    color: var(--rose);
    margin-bottom: 15px;
}

.subtitle {
    margin-bottom: 35px;
    color: #92717e;
}

/* Floating hearts */

.heart {
    position: fixed;
    bottom: -30px;
    pointer-events: none;
    z-index: 100;
    animation: floatUp linear forwards;
}

@keyframes floatUp {
    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

/* HERO */

.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px 20px;
    color: white;
    background:
        linear-gradient(rgba(63, 24, 48, .52), rgba(63, 24, 48, .58)),
        url('https://images.unsplash.com/photo-1513151233558-d860c5398176?auto=format&fit=crop&w=1800&q=85')
        center/cover;
}

.hero .small {
    letter-spacing: 4px;
    text-transform: uppercase;
    font-size: 12px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(3.5rem, 10vw, 6.5rem);
    line-height: 1.2;
    text-shadow: 0 4px 20px #0005;
}

.hero p {
    max-width: 550px;
    line-height: 1.9;
    margin: 20px auto;
}

.hero button, .main-btn {
    background: white;
    color: var(--rose);
    padding: 14px 30px;
    border-radius: 40px;
    font-size: 15px;
    font-weight: 600;
    transition: .3s;
    box-shadow: 0 5px 20px #0002;
}

.hero button:hover, .main-btn:hover {
    transform: translateY(-4px);
    background: var(--light-pink);
}

/* COUNTDOWN */

.countdown {
    background: linear-gradient(135deg, #ffe4ec, #f2e6ff);
}

.timer {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 30px;
}

.time-box {
    background: white;
    width: 110px;
    padding: 22px 10px;
    border-radius: 18px;
    box-shadow: 0 8px 25px #e7548018;
}

.time-box strong {
    display: block;
    font-size: 32px;
    color: var(--rose);
}

.time-box span {
    font-size: 12px;
    text-transform: uppercase;
}

/* BIRTHDAY MESSAGE */

.message-card {
    max-width: 750px;
    margin: auto;
    padding: 40px;
    background: white;
    border-radius: 25px;
    box-shadow: 0 10px 35px #e7548018;
    line-height: 2;
}

/* BIRTHDAY CARD MAKER */

.card-maker {
    background: #fff0f4;
}

.card-preview {
    max-width: 500px;
    min-height: 220px;
    margin: 25px auto;
    padding: 30px;
    border-radius: 25px;
    background: linear-gradient(135deg, #ffb6c9, #d9b8f3);
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0 10px 30px #d98ba955;
}

.card-preview h3 {
    font-family: 'Great Vibes', cursive;
    font-size: 40px;
}

.card-preview p {
    margin-top: 12px;
    line-height: 1.8;
    overflow-wrap: anywhere;
}

.editor {
    max-width: 500px;
    margin: auto;
}

.editor input, .editor textarea {
    width: 100%;
    padding: 14px;
    margin: 8px 0;
    border: 1px solid #f4c5d4;
    border-radius: 12px;
    outline: none;
    background: white;
}

.editor textarea {
    resize: vertical;
    min-height: 90px;
}

.main-btn {
    background: var(--rose);
    color: white;
    margin: 10px 5px;
}

/* LOVE QUIZ */

.quiz-container {
    max-width: 600px;
    margin: auto;
    padding: 30px;
    border-radius: 25px;
    background: white;
    box-shadow: 0 10px 35px #e7548018;
}

.quiz-container h3 {
    margin-bottom: 20px;
}

.answers {
    display: grid;
    gap: 12px;
}

.answer {
    padding: 14px;
    border-radius: 12px;
    background: #ffe8ef;
    color: var(--dark);
    transition: .3s;
}

.answer:hover {
    background: var(--pink);
    color: white;
    transform: scale(1.02);
}

#quiz-result {
    margin-top: 20px;
    font-weight: 600;
}

/* PHOTO GALLERY */

.gallery {
    background: #fff0f4;
}

.slideshow {
    max-width: 650px;
    margin: 25px auto;
    position: relative;
}

.slideshow img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    border-radius: 25px;
    box-shadow: 0 10px 30px #0002;
}

.caption {
    margin: 15px;
    font-style: italic;
}

.slide-controls {
    display: flex;
    justify-content: center;
    gap: 15px;
}

.slide-controls button {
    padding: 12px 25px;
    border-radius: 25px;
    background: var(--rose);
    color: white;
}

.upload-area {
    margin: 25px auto;
}

.upload-area input {
    max-width: 250px;
}

/* FINAL SURPRISE */

.surprise {
    background: linear-gradient(135deg, #f5d9eb, #ffe7ed);
}

.hidden {
    display: none !important;
}

.love-letter {
    max-width: 650px;
    margin: 30px auto;
    background: white;
    border-radius: 25px;
    padding: 35px;
    line-height: 2;
    box-shadow: 0 10px 30px #e7548020;
    animation: reveal .8s ease;
}

@keyframes reveal {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

video {
    width: 100%;
    max-width: 600px;
    border-radius: 20px;
    margin-top: 20px;
}

/* FOOTER */

footer {
    background: #593747;
    color: white;
    padding: 35px 20px;
    text-align: center;
    line-height: 2;
}

footer a {
    color: #ffb6c9;
    text-decoration: none;
    margin: 0 10px;
}

/* CONFETTI */

.confetti {
    position: fixed;
    top: -15px;
    z-index: 999;
    pointer-events: none;
    animation: fall 3s linear forwards;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
    }
}

/* RESPONSIVE */

@media(max-width: 600px) {
    section {
        padding: 65px 15px;
    }

    .time-box {
        width: 75px;
        padding: 15px 5px;
    }

    .time-box strong {
        font-size: 25px;
    }

    .slideshow img {
        height: 280px;
    }

    .message-card, .quiz-container, .love-letter {
        padding: 22px;
    }

    .hero h1 {
        font-size: 3.5rem;
    }
}
</style>
</head>

<body>

<!-- FLOATING HEARTS -->
<div id="hearts"></div>

<!-- HOME PAGE -->
<header class="hero" id="home">

    <div class="small">A special day for someone special ❤️</div>

    <h1>Happy Birthday,<br>My Love!</h1>

    <p>
        Today is all about you, my beautiful girl.
        You make my world brighter, my days happier
