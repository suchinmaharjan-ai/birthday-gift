    <div class="slideshow">

        <img id="slide-image"
             src="https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=1200&q=85"
             alt="Romantic memory">

        <p class="caption" id="slide-caption">
